# The one Application that has to be bootstrapped.
#
# Everything ArgoCD manages comes from Git. This object is the exception, because
# something has to tell ArgoCD where Git is. It is the only Kubernetes object in this
# repository that does not live in k8s/.
#
# It is a separate file rather than part of the ArgoCD Helm release. Helm resolves every
# object in a release against the API server before installing any of them, so a custom
# resource whose CRD the same release provides fails at validation:
#
#   Error: INSTALLATION FAILED: resource mapping not found for name: "site"
#   no matches for kind "Application" in version "argoproj.io/v1alpha1"
#   ensure CRDs are installed first
#
# k3s applies each file in its manifests directory independently and retries the ones
# that fail, so this one succeeds on a later pass once the chart has created the CRD.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: site
  namespace: argocd
spec:
  project: default
  source:
    repoURL: ${repo_url}
    path: k8s/site
    targetRevision: ${repo_revision}
  destination:
    server: https://kubernetes.default.svc
    namespace: web
  syncPolicy:
    automated:
      # Revert changes made directly against the cluster. Without this a kubectl edit
      # survives and ArgoCD reports OutOfSync indefinitely.
      selfHeal: true
      # Delete what is removed from Git. Without this, deleting a file leaves the
      # resource running forever.
      prune: true
    syncOptions:
      - CreateNamespace=true
