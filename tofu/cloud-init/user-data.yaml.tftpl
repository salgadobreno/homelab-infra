#cloud-config
# Bootstrap for a k3s server node (design D6).
#
# This file is deliberately short. It creates the operator account, installs the
# guest agent, and installs k3s — nothing else. Everything above the OS is the
# cluster's job, reconciled by GitOps, not configured here.
#
# If this grows past what fits on one screen, that is the signal to reconsider a
# configuration-management layer — not a reason to pre-emptively add one.

hostname: ${hostname}
fqdn: ${hostname}
prefer_fqdn_over_hostname: false

users:
  - name: ${operator_user}
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - "${ssh_public_key}"

package_update: true
packages:
  - qemu-guest-agent

write_files:
  # k3s applies this directory at startup, so dropping the file here before k3s is
  # installed means the reconciler comes up with the cluster rather than after it.
  # The body lives in its own file — this template stays readable, and the manifest
  # stays valid YAML that an editor can check.
  - path: /var/lib/rancher/k3s/server/manifests/argocd.yaml
    owner: "root:root"
    permissions: "0600"
    content: |
      ${indent(6, argocd_manifest)}

runcmd:
  # Guest agent first: graceful shutdown and Proxmox UI integration. Nothing
  # depends on it for addressing — the address is static (design D7).
  - systemctl enable --now qemu-guest-agent

  # k3s, pinned. INSTALL_K3S_EXEC advertises the node's static address so the
  # generated kubeconfig and any future agent joins both target something
  # reachable off-node, rather than 127.0.0.1.
  - >
    curl -sfL https://get.k3s.io
    | INSTALL_K3S_VERSION="${k3s_version}"
    INSTALL_K3S_EXEC="server --tls-san ${node_address} --node-ip ${node_address} --write-kubeconfig-mode 644${disable_flags}"
    sh -

  # A marker the provisioner can wait on, written only after k3s reports ready.
  #
  # The node object does not exist the instant k3s starts, and `kubectl wait` does
  # not block for a resource to appear — it fails immediately with "no matching
  # resources found". Poll for existence first, then wait on the condition, and
  # only then write the marker. `set -e` means a timeout leaves the marker absent
  # and records a cloud-init error, rather than reporting a success that never
  # happened.
  - |
    set -e
    for i in $(seq 1 60); do
      k3s kubectl get node ${hostname} >/dev/null 2>&1 && break
      sleep 5
    done
    k3s kubectl wait --for=condition=Ready node/${hostname} --timeout=300s
    touch /run/cloud-init-k3s-complete

final_message: "k3s server ready on ${node_address} after $UPTIME seconds"
