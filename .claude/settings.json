{
  "permissions": {
    "allow": [
      "Bash(tofu validate:*)",
      "Bash(tofu plan:*)",
      "Bash(tofu fmt:*)",
      "Bash(tofu init:*)",
      "Bash(tofu output:*)",
      "Bash(tofu show:*)",
      "Bash(tofu version:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/disclosure-hook.sh"
          }
        ]
      }
    ]
  }
}
